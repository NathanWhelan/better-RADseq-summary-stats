# Regenerated by test/make_fixtures.R and test/run_tests.sh -- not source.
# (test/golden/*.tsv is intentionally NOT matched by these: the globs below
# don't cross the golden/ subdirectory boundary, and those files are the
# checked-in reference values the regenerated output is diffed against.)
test/*.vcf
test/*.vcf.gz
test/*.tsv

# Claude Code's own local session state, not project content.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Real Stacks `populations` output dropped at the repo root -- real (possibly
# unpublished) data, never package content. Test fixtures live under
# tests/testthat/fixtures/ and inst/extdata/ instead.
/populations.*

# R package build/check artifacts -- not source.
/*.Rcheck/
/RADdiversity_*.tar.gz
.Rhistory
.RData
.Rproj.user
